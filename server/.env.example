# server/.env — copy to .env and fill in (NEVER commit the real one)
# Stripe test keys: Dashboard → Developers → API keys (sk_test_...)
STRIPE_SECRET_KEY=«redacted:sk_test_…»
# Webhook signing secret: Dashboard → Developers → Webhooks → your endpoint → signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Public base URL of this server (used for the payment-link success redirect + email-recovery portal links)
BASE_URL=http://localhost:8787
# Port to listen on
PORT=8787
# Admin token for minting keys at /admin (make it long + random — this is
# the master key to your license inventory)
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Secure email recovery ─────────────────────────────────────────────────────
# Secret used to seal (AES-GCM) and HMAC the email-recovery / browser-reset
# management tokens. BLANK disables every recovery POST with a fixed 503
# envelope — the email-recovery portal page still renders, but recovery is
# safe-by-disclosure and no outbox row is sent.
#
# REQUIREMENTS — must hold in production:
#   • At least 32 random bytes (>= 16 chars minimum; longer is safer).
#   • Must NEVER match STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#     RESEND_WEBHOOK_SECRET, RESEND_API_KEY, or ADMIN_TOKEN. These are
#     separate secret domains with different threat models; reusing one
#     breaks the recovery seal and leaks across trust boundaries.
#   • Rotating this secret invalidates every outstanding recovery and reset
#     link — plan rotation windows around active customer support cases.
# Generate with: `openssl rand -hex 32`
MANAGEMENT_TOKEN_SECRET=
# Recovery rate-limit tunables — positive integers, fall back to defaults on
# invalid/blank. Defaults match the accepted Slice 3B-2A core.
RECOVERY_WINDOW_MS=900000        # fixed-window length (15 min)
RECOVERY_EMAIL_LIMIT=3           # max recovery POSTs per email per window
RECOVERY_IP_LIMIT=10             # max recovery POSTs per IP per window
RECOVERY_MIN_RESPONSE_MS=350     # fixed min neutral recovery-response delay (ms); equalizes
                                 # answer latency across known/unknown/rate-limited emails so
                                 # request timing cannot reveal membership or license count

# Family invite redemption reuses MANAGEMENT_TOKEN_SECRET for public HMAC
# rate-limit subjects. Admin invite mint/revoke uses ADMIN_TOKEN as a Bearer
# credential and as the admin rate-limit HMAC key. No additional secret.
INVITE_WINDOW_MS=900000
INVITE_IP_LIMIT=20
INVITE_CODE_LIMIT=5
INVITE_ADMIN_IP_LIMIT=20
INVITE_MIN_RESPONSE_MS=350

# ── Email (Resend) — leave RESEND_API_KEY blank to disable the scheduler ──
# Resend API key (re_…). Blank/whitespace ⇒ scheduler disabled, Stripe still
# queues, /health surfaces DB counts + disabled-safe runtime fields.
RESEND_API_KEY=
# Resend webhook signing secret (whsec_…). Used for POST /api/resend/webhook
# (svix-verified). Blank ⇒ the route returns a fixed 500.
RESEND_WEBHOOK_SECRET=
# Default visible sender (must be on a verified Resend domain).
EMAIL_FROM="Class Navi Pro Tools <licenses@send.nimira-timer.com>"
# Default Reply-To address.
EMAIL_REPLY_TO=support@nimira-timer.com

# Email scheduler tunables — all positive integers; invalid/blank values
# fall back to the defaults below (never crash).
EMAIL_POLL_INTERVAL_MS=5000
EMAIL_DRAIN_MAX_ITER=20
EMAIL_LEASE_MS=60000
EMAIL_DAILY_CAP=100
EMAIL_DAILY_WARN=80
EMAIL_RETRY_BASE_MS=60000
EMAIL_RETRY_MAX_MS=3600000